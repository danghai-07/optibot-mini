# Gemini (required for upload / sync)
GEMINI_API_KEY=...
# Create store: python scripts/create_gemini_store.py
GEMINI_FILE_SEARCH_STORE=fileSearchStores/...

# Zendesk Help Center (optional; defaults shown)
ZENDESK_BASE_URL=https://support.optisigns.com
ZENDESK_LOCALE=en-us
MIN_ARTICLES=30
# Optional cap for first sync / testing (leave empty to sync all)
# MAX_ARTICLES=40

# Paths (optional; defaults relative to repo root)
ARTICLES_DIR=data/articles
MANIFEST_PATH=state/manifest.json
